root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 88

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# dos espacios al final es un salto de linea en Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.{ps1,psm1}]
end_of_line = crlf

[Makefile]
indent_style = tab
